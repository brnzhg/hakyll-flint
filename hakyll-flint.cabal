cabal-version:      3.4
name:               hakyll-flint
version:            0.1.0.0
synopsis:           Obsidian-flavoured extensions for Hakyll: custom properties, backlinks
description:
  Extensions for the Hakyll static site generator. The first feature is
  user-declared metadata /properties/ (a generalisation of Hakyll's tags)
  that can be indexed, given their own pages and queried from any page.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Brian Zhang
maintainer:         Brian Zhang
category:           Web
homepage:           https://github.com/brnzhg/hakyll-flint
bug-reports:        https://github.com/brnzhg/hakyll-flint/issues
build-type:         Simple
tested-with:        GHC ==9.10.3
extra-doc-files:    README.md

source-repository head
  type:     git
  location: https://github.com/brnzhg/hakyll-flint.git

common shared
  default-language:   GHC2024
  default-extensions:
    DerivingStrategies
    OverloadedStrings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Wredundant-constraints
    -Wmissing-deriving-strategies -Wunused-packages
  build-depends:
    , base  >=4.20 && <5

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Hakyll.Flint
    Hakyll.Flint.Property
    Hakyll.Flint.Property.Types
    Hakyll.Flint.WikiLink
  build-depends:
    , aeson         >=2.0  && <2.4
    , binary        >=0.8  && <0.9
    , blaze-html    >=0.9  && <0.10
    , containers    >=0.6  && <0.9
    , hakyll        >=4.16 && <4.18
    , pandoc        >=3.0  && <3.14
    , pandoc-types  >=1.23 && <1.24
    , scientific    >=0.3  && <0.4
    , text          >=2.0  && <2.2

executable flint-example
  import:          shared
  hs-source-dirs:  example
  main-is:         Main.hs
  other-modules:   Site
  -- `watch` (file watcher + preview server) needs the threaded runtime.
  ghc-options:     -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , hakyll
    , hakyll-flint

test-suite spec
  import:          shared
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test example
  main-is:         Main.hs
  other-modules:   Site
  ghc-options:     -threaded
  build-depends:
    , aeson
    , directory     >=1.3 && <1.4
    , filepath      >=1.4 && <1.6
    , hakyll
    , hakyll-flint
    , tasty         >=1.4 && <1.6
    , tasty-hunit   >=0.10 && <0.11
    , temporary     >=1.3 && <1.4
    , text
